<!DOCTYPE html>
<html>
  <head>
    <title>Controle de Orçamento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <div class="container mt-4">
      <h1>Controle de Orçamento</h1>
      
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title">Definir Renda Mensal</h5>
          <form method="POST">
            <div class="input-group">
              <input type="text" name="receita" class="form-control" placeholder="Digite sua renda mensal" value="{{ receita }}">
              <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title">Adicionar Gasto</h5>
          <!-- Modal de Nova Categoria -->
          <div class="modal fade" id="novaCategoriaModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Adicionar Nova Categoria</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="POST">
                  <div class="modal-body">
                    <input type="text" name="nova_categoria" class="form-control" required>
                    <input type="hidden" name="acao" value="nova_categoria">
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar Categoria</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <form method="POST">
            <div class="mb-3">
              <input type="date" name="data" class="form-control" required>
            </div>
            <div class="mb-3">
              <input type="text" name="descricao" class="form-control" placeholder="Descrição" required>
            </div>
            <div class="mb-3">
              <input type="text" name="valor" class="form-control" placeholder="Valor" required>
            </div>
            <div class="mb-3">
              <select name="categoria" class="form-control" required>
                <option value="">Selecione uma categoria</option>
                {% for categoria in categorias_padrao %}
                <option value="{{ categoria }}">{{ categoria }}</option>
                {% endfor %}
              </select>
              <button type="button" class="btn btn-secondary mt-2" data-bs-toggle="modal" data-bs-target="#novaCategoriaModal">
                Adicionar Nova Categoria
              </button>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Gasto</button>
          </form>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Resumo</h5>
              <p>Renda: R$ {{ "%.2f"|format(receita) }}</p>
              <p>Total de Gastos: R$ {{ "%.2f"|format(total) }}</p>
              <p>Saldo: R$ {{ "%.2f"|format(saldo) }}</p>
              <p>Restante: {{ "%.1f"|format(restante) }}%</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Gastos por Categoria</h5>
              {% for categoria, valor in categorias.items() %}
              <p>{{ categoria }}: R$ {{ "%.2f"|format(valor) }}</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-body">
          <h5 class="card-title">Gastos Recentes</h5>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Data (dia/mês/ano)</th>
                  <th>Descrição</th>
                  <th>Categoria</th>
                  <th>Valor</th>
                  <th>% da Renda</th>
                </tr>
              </thead>
              <tbody>
                {% for gasto in gastos %}
                <tr>
                  <td>{{ gasto.data }}</td>
                  <td>{{ gasto.descricao }}</td>
                  <td>{{ gasto.categoria }}</td>
                  <td>R$ {{ "%.2f"|format(gasto.valor) }}</td>
                  <td>{{ "%.1f"|format((gasto.valor / receita * 100) if receita > 0 else 0) }}%</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-body">
          <h5 class="card-title">Distribuição de Gastos</h5>
          <canvas id="graficoGastos"></canvas>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      const ctx = document.getElementById('graficoGastos');
      new Chart(ctx, {
        type: 'pie',
        data: {
          labels: [{% for categoria, valor in categorias.items() %}'{{ categoria }}',{% endfor %}],
          datasets: [{
            data: [{% for categoria, valor in categorias.items() %}{{ "%.1f"|format(valor / receita * 100) if receita > 0 else 0 }},{% endfor %}],
            backgroundColor: [
              '#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF',
              '#FF9F40','#FF6384','#36A2EB','#FFCE56','#4BC0C0',
              '#9966FF','#FF9F40','#FF6384','#36A2EB','#FFCE56'
            ]
          }]
        },
        options: {
          responsive: true,
          plugins: {
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.label + ': ' + context.raw.toFixed(1) + '% da renda';
                }
              }
            }
          }
        }
      });
    </script>
  </body>
</html>
